echo    4. 把链接或二维码截图、注册码发到学校老师群即可；
echo    5. 全校建完班后关掉开关，已建班级不受影响。
echo.
echo  优点：不用改配置文件、不用重启，不影响已装好的一体机、
echo        管理员群发和 VOI 桌面云自动认班。
echo.
pause
